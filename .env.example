PORT=5178
HOST=0.0.0.0
ADMIN_PASSWORD=change-me
DATA_DIR=./data
# OpenAI-compatible provider (leave key blank for Mock)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OpenRouter: set these only when using OpenRouter; these names take priority.
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=inclusionai/ling-3.1-flash
# OPENAI_API_KEY may also hold the OpenRouter key for backward compatibility.
AI_MODE=auto
# Optional HTTP CONNECT proxy for Node (example only; use your actual port)
# AI_PROXY_URL=http://127.0.0.1:7890
